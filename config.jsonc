{
  // Matsurikafetch configuration (JSONC: comments and trailing commas are allowed).
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // "matsurika" uses the bundled transparent artwork; "auto" uses a distro logo.
    "source": "matsurika",
    "height": 24,
    "padding": {
      "top": 2,
      "right": 3
    },
    "color": {
      "1": "#dddaec",
      "2": "#7a5ade"
    }
  },

  "display": {
    "separator": "  ➜  ",
    "color": {
      "keys": "white",
      "title": "white"
    },
    "key": {
      "width": 14
    }
  },

  // Module order is the display order. Use "break" for a blank line.
  // Supported modules: title, separator, os, kernel, packages, shell, wm,
  // terminal, media, battery, uptime, age, cpu, gpu, storage, memory, colors.
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "  os  "
    },
    {
      "type": "kernel",
      "key": "⚙  ker "
    },
    {
      "type": "packages",
      "key": "  pkg "
    },
    {
      "type": "shell",
      "key": "  sh  "
    },
    {
      "type": "wm",
      "key": "  wm  "
    },
    {
      "type": "terminal",
      "key": "  term"
    },
    "break",
    {
      "type": "media",
      "key": "  med "
    },
    {
      "type": "battery",
      "key": "  bat "
    },
    {
      "type": "uptime",
      "key": "⏱  up  "
    },
    {
      "type": "age",
      "key": "  age"
    },
    "break",
    {
      "type": "cpu",
      "key": "  cpu "
    },
    {
      "type": "gpu",
      "key": "  gpu "
    },
    {
      "type": "storage",
      "key": "  disk"
    },
    {
      "type": "memory",
      "key": "  mem "
    },
    "break",
    "colors"
  ],

  "color": true,
  "nerd_font": true,
  "image_protocol": "auto"
}
